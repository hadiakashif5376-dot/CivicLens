# Copy this file to .streamlit/secrets.toml for local runs (that file is git-ignored).
# On Streamlit Community Cloud, paste the same lines into the app's Secrets box instead.

# Local demo (data is lost on Streamlit Cloud restarts):
DATABASE_URL = "sqlite:///./civiclens.db"

# Real storage: a Supabase Postgres connection string. If the password contains symbols,
# percent-encode them (for example @ becomes %40).
# DATABASE_URL = "postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# First officer account, created on start-up if it does not exist.
OFFICER_EMAIL = "officer@example.com"
OFFICER_PASSWORD = "choose-a-strong-password"

# Times are stored in UTC and shown in this time zone.
DISPLAY_TZ = "Asia/Karachi"

# Optional: AI reading of complaints with Groq (https://console.groq.com/keys).
# Without a key the app uses keyword rules. GROQ_MODEL is optional; the default is "openai/gpt-oss-120b".
GROQ_API_KEY = "paste-your-key-here"
# GROQ_MODEL = "openai/gpt-oss-120b"
